<script>
  const themeBtn = document.getElementById("themeToggle");
  function applyTheme(t){
    document.documentElement.setAttribute("data-theme", t);
    themeBtn.textContent = t === "dark" ? "Modo claro" : "Modo oscuro";
    try { localStorage.setItem("impacto-theme", t); } catch(e){}
  }
  themeBtn.addEventListener("click", () => {
    const cur = document.documentElement.getAttribute("data-theme");
    const next = cur === "dark" ? "light" : (cur === "light" ? "dark" : (matchMedia("(prefers-color-scheme: dark)").matches ? "light" : "dark"));
    applyTheme(next);
  });
  try {
    const saved = localStorage.getItem("impacto-theme");
    if (saved) applyTheme(saved);
    else themeBtn.textContent = matchMedia("(prefers-color-scheme: dark)").matches ? "Modo claro" : "Modo oscuro";
  } catch(e){}
</script>

