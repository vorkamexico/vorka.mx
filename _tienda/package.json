{
  "name": "vorka-tienda",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "check": "vitest run && wrangler deploy --dry-run --outdir .dist",
    "db:local": "wrangler d1 migrations apply vorka-tienda --local",
