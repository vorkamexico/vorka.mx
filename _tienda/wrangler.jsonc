{
  // Tienda de productos digitales de Vorka México: vive en rutas de vorka.mx, el resto del sitio no pasa por aquí
  "name": "vorka-tienda",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "vorka.mx/tienda*", "zone_name": "vorka.mx" },
    { "pattern": "vorka.mx/api/*", "zone_name": "vorka.mx" },
    { "pattern": "vorka.mx/descargas*", "zone_name": "vorka.mx" },
    { "pattern": "vorka.mx/creadores*", "zone_name": "vorka.mx" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "vorka-tienda", "database_id": "7e6febec-475c-4810-a32f-c8a79659dbfd", "migrations_dir": "migrations" }
  ],
  // Bucket privado: los archivos solo salen por /descargas/<token>, nunca por URL pública
  "r2_buckets": [
    { "binding": "PRODUCTOS", "bucket_name": "vorka-productos" }
  ],
  // Correos de entrega: por Vorka OS (clase Correo), que ya tiene la llave de Resend
  "services": [
    { "binding": "CORREO", "service": "vorka-os", "entrypoint": "Correo" }
  ],
  "vars": {
    "SITE_URL": "https://vorka.mx",
    // Marketplace de creadores: "1" abre vorka.mx/creadores (apagado hasta tener la revisión fiscal)
    "MARKETPLACE": "0",
    // Llave publicable de Stripe (no es secreta): la usan los componentes incrustados del portal de creadores
    "STRIPE_PUBLISHABLE_KEY": ""
  },
  // Cada hora: transferencias a creadores (marketplace)
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true },
  // Entorno de PRUEBAS (Stripe en modo prueba): npx wrangler deploy --env pruebas
  // Base de datos y archivos propios; no toca la tienda real. Marketplace encendido.
  "env": {
    "pruebas": {
      "name": "vorka-tienda-pruebas",
      "workers_dev": true,
      "routes": [],
      "d1_databases": [
        { "binding": "DB", "database_name": "vorka-tienda-pruebas", "database_id": "6f80e8b9-fb89-43b2-82f0-fb317d95ce62", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [
        { "binding": "PRODUCTOS", "bucket_name": "vorka-productos-pruebas" }
      ],
      "services": [
        { "binding": "CORREO", "service": "vorka-os", "entrypoint": "Correo" }
      ],
      "vars": {
        "SITE_URL": "https://vorka-tienda-pruebas.oleynickhdz.workers.dev",
        "MARKETPLACE": "1",
        "STRIPE_PUBLISHABLE_KEY": "",
        // Estilos, imágenes y demás páginas salen del sitio real
        "ESTATICO_DEV": "https://vorka.mx"
      },
      "triggers": { "crons": ["17 * * * *"] }
    }
  }
}
