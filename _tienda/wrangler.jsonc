{
  // Tienda de productos digitales de Vorka México: vive en rutas de vorka.mx, el resto del sitio no pasa por aquí
  "name": "vorka-tienda",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "vorka.mx/tienda*", "zone_name": "vorka.mx" },
    { "pattern": "vorka.mx/api/*", "zone_name": "vorka.mx" },
    { "pattern": "vorka.mx/descargas*", "zone_name": "vorka.mx" }
  ],
  "d1_databases": [
    // database_id: pegar el id que da `wrangler d1 create vorka-tienda` (ver README-TIENDA.md)
    { "binding": "DB", "database_name": "vorka-tienda", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  // Bucket privado: los archivos solo salen por /descargas/<token>, nunca por URL pública
  "r2_buckets": [
    { "binding": "PRODUCTOS", "bucket_name": "vorka-productos" }
  ],
  "vars": {
    "SITE_URL": "https://vorka.mx",
    // Métodos de Stripe Checkout; quitar uno si la cuenta no lo tiene activo (customer_balance = SPEI)
    "STRIPE_METODOS": "card,oxxo,customer_balance"
  },
  "observability": { "enabled": true }
}
