          "a": "trazo",
          "d": "M 690 520 L 690 490 L 720 490",
          "color": "verde",
          "en": "ángulo recto",
          "ancho": 5
        },
        {
          "a": "escribe",
          "texto": "a² + b² = c²",
          "x": 70,
          "y": 130,
          "color": "verde",
          "tam": 86,
          "en": "Entonces se cumple"
        }
      ],
      "inicio": 7.24
