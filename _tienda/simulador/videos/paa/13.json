    {
      "escena": "El narrador",
      "voz": "Para el narrador, pregunta: ¿habla en primera persona? Si cuenta su propia historia, es protagonista. Si cuenta lo que le pasa a otro, es testigo.",
      "acciones": [
        {
          "a": "escribe",
          "texto": "¿Habla en «yo»?",
          "x": 60,
          "y": 150,
          "tam": 72,
          "en": "primera persona"
        },
        {
          "a": "escribe",
          "texto": "su historia → protagonista",
          "x": 60,
          "y": 290,
          "color": "verde",
          "tam": 60,
          "en": "es protagonista"
        },
        {
          "a": "escribe",
          "texto": "la de otro → testigo",
          "x": 60,
          "y": 410,
          "color": "amarillo",
          "tam": 60,
          "en": "es testigo"
        }
      ],
      "limpia": true,
      "inicio": 25.13
    },
